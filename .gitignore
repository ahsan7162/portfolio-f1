node_modules
dist
dist-ssr
.DS_Store
*.tsbuildinfo

# HyperFrames stills: motion-lab/build.mjs copies or builds the assets, and the
# snapshots end up in public/ (og.jpg, apple-touch-icon.png)
motion-lab/*/assets/
motion-lab/*/snapshots/
motion-lab/*/renders/
motion-lab/*/.hyperframes/

# HyperFrames films: renders, snapshots and caches regenerate from the sources
# (videos/onboard-lap: npm run film; the other films: npm run render)
videos/*/renders/
videos/*/snapshots/
videos/*/.hyperframes/
videos/*/.thumbnails/
videos/*/.waveform-cache/
